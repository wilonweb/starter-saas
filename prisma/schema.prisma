generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String?            @unique
  notionId         String?            @unique
  stripeCustomerId String?            @unique
  accounts         ProviderAccount[]
  subscriptions    Subscription[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model ProviderAccount {
  id                 String   @id @default(cuid())
  userId             String
  provider           String   // "notion"
  providerAccountId  String   // notion workspace/user id si dispo
  accessToken        String
  refreshToken       String?  // Notion ne renvoie pas toujours un refresh
  tokenType          String?  // "bearer"
  scope              String?  // si utile
  expiresAt          DateTime? // si le token expire (Notion est souvent long-lived)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  status               String
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
